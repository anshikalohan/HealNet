# HealNet Environment Configuration Example
# Copy this file to .env and fill in your actual values

# --------------------------
# Required API Keys
# --------------------------

# Groq API Key (for LLM / RAG Chat)
GROQ_API_KEY=your_groq_api_key_here

# Twilio Credentials (for WhatsApp Integration)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=whatsapp:+14155238886

# Google Maps API Key (for finding nearby facilities)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# --------------------------
# Application Settings
# --------------------------

# Database Path (SQLite)
DATABASE_PATH=healnet.db

# Path to directory containing ML Models (.h5, .keras)
MODELS_PATH=app/models

# Directory for temporary file uploads
UPLOAD_DIR=/tmp/healnet_uploads
